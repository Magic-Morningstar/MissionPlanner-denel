<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  TEMPLATE. The real credentials.xml is generated on the VM by replacing the
  password placeholders with salted hashes (README.md, step 6). Never commit
  the generated file.

  One user per ROLE per vehicle, following the bridge's topic layout
  (topics.py, TopicSet):

    denel/uav/<vid>/mavlink/from_vehicle   aircraft publishes, GCS subscribes
    denel/uav/<vid>/mavlink/to_vehicle     GCS publishes, aircraft subscribes
    denel/uav/<vid>/status/link            aircraft publishes (retained + Last Will)
    denel/uav/<vid>/status/gcs             GCS publishes (retained + Last Will)

  Anything not granted here is denied. In particular the aircraft user CANNOT
  publish to to_vehicle, the GCS user CANNOT publish to from_vehicle, and
  neither can touch another vehicle's topics: those are the Phase 3 negative
  acceptance tests.

  The File RBAC extension rejects '#' and '+' in client ids and usernames,
  which topics.validate_vehicle_id() already enforces for vehicle ids.
-->
<file-rbac>
    <users>
        <user>
            <name>uav01-aircraft</name>
            <password>__HASH_AIRCRAFT__</password>
            <roles><id>uav01-aircraft</id></roles>
        </user>
        <user>
            <name>uav01-gcs</name>
            <password>__HASH_GCS__</password>
            <roles><id>uav01-gcs</id></roles>
        </user>
        <user>
            <name>smoke-test</name>
            <password>__HASH_SMOKE__</password>
            <roles><id>smoke-test</id></roles>
        </user>
    </users>

    <roles>
        <role>
            <id>uav01-aircraft</id>
            <permissions>
                <permission>
                    <topic>denel/uav/uav01/mavlink/from_vehicle</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <permission>
                    <topic>denel/uav/uav01/status/link</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>denel/uav/uav01/mavlink/to_vehicle</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>

        <role>
            <id>uav01-gcs</id>
            <permissions>
                <permission>
                    <topic>denel/uav/uav01/mavlink/to_vehicle</topic>
                    <activity>PUBLISH</activity>
                    <retain>NOT_RETAINED</retain>
                </permission>
                <permission>
                    <topic>denel/uav/uav01/status/gcs</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>denel/uav/uav01/mavlink/from_vehicle</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <!-- status_watch reads both status topics -->
                    <topic>denel/uav/uav01/status/+</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>

        <role>
            <!-- mqtt_smoke only. Cannot see or touch any vehicle topic. -->
            <id>smoke-test</id>
            <permissions>
                <permission>
                    <topic>denel/uav/_smoke/#</topic>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
