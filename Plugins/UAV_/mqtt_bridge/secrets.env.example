# Copy to secrets.env (gitignored) and fill in. Credentials ONLY -- everything
# else belongs in bridge_config.py or an environment variable, where it stays
# visible in logs and diffs.
#
# secrets.env is read from the directory containing bridge_config.py. Values may
# be quoted, which matters for a password containing a space or a '#'.
#
# Unused until Phase 3 adds TLS and broker authentication; present now so there
# is somewhere obvious to put a credential instead of a source file.

MQTT_USERNAME=
MQTT_PASSWORD=

# TLS (Phase 3). Paths, not contents.
#TLS_ENABLED=true
#TLS_CA_FILE=/etc/denel/ca.crt
#TLS_CERT_FILE=/etc/denel/client.crt
#TLS_KEY_FILE=/etc/denel/client.key
#BROKER_PORT=8883
