# Copy to secrets.env (gitignored) and fill in. Credentials ONLY -- everything
# else belongs in bridge_config.py or an environment variable, where it stays
# visible in logs and diffs.
#
# secrets.env is read from the directory containing bridge_config.py. Values may
# be quoted, which matters for a password containing a space or a '#'.
#
# The password belongs here or in DENEL_MQTT_MQTT_PASSWORD -- there is
# deliberately no --password flag. The username may also be given with
# --username, and TLS with --tls / --tls-ca-file.

MQTT_USERNAME=
MQTT_PASSWORD=

# TLS (Phase 3). Paths, not contents.
#TLS_ENABLED=true
#TLS_CA_FILE=/etc/denel/ca.crt
#TLS_CERT_FILE=/etc/denel/client.crt
#TLS_KEY_FILE=/etc/denel/client.key
#BROKER_PORT=8883

# --- GCS machine, bridge started by Mission Planner -----------------------
# DenelMqttBridgeLauncher.cs starts the GCS bridge with no command-line
# settings, so on that machine put the broker settings here too. Any key from
# bridge_config.py is accepted in this file.
#BROKER_HOST=hivemq-broker.southafricanorth.cloudapp.azure.com
#BROKER_PORT=8883
#TLS_ENABLED=true
#VEHICLE_ID=uav01
#MQTT_USERNAME=uav01-gcs
#MQTT_PASSWORD=
# Then create mqtt_bridge\enabled.txt (empty) to switch the launcher on.
