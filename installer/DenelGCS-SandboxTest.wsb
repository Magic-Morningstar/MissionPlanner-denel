<Configuration>
  <VGpu>Disable</VGpu>
  <!-- Networking deliberately disabled: this is the real test of the installer's
       offline claim. If it only works with a network available, that's a bug. -->
  <Networking>Disable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\MissionPlanner-denel\installer\output</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\DenelInstaller</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>explorer.exe C:\Users\WDAGUtilityAccount\Desktop\DenelInstaller</Command>
  </LogonCommand>
</Configuration>
